# /etc/trebuchet/backup.env — owner root, mode 0600. Contains the S3 key: never commit it.
#
# Any S3-compatible storage with Object Lock works, e.g. Yandex Object Storage,
# Selectel S3, Backblaze B2, Cloudflare R2. The bucket needs:
#   - versioning + Object Lock with DEFAULT retention, mode COMPLIANCE, 30-90 days;
#   - a key that can only PutObject into this bucket (no delete, ideally no read).

BACKUP_S3_ENDPOINT=https://storage.yandexcloud.net
BACKUP_S3_REGION=ru-central1
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# Prefix inside the bucket
BACKUP_PREFIX=trebuchet/

# File with age PUBLIC recipients (age1... or age1yubikey1...), one per line.
# The private keys stay offline (paper / YubiKey). Never put AGE-SECRET-KEY here.
BACKUP_AGE_RECIPIENTS_FILE=/etc/trebuchet/backup-recipients.txt

# What to back up: consistent snapshots written by services (vault, later)
BACKUP_SOURCE=/srv/trebuchet/data/snapshots
