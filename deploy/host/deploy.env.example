# /etc/trebuchet/deploy.env — owner root, mode 0600.
# No secrets here: the deployer only reads public data (git, ghcr.io, Sigstore).

# GitHub repository, owner/name
TREBUCHET_REPO=Valek2225/Trebuchet

# Git checkout on the server (cloned over HTTPS, read-only usage)
TREBUCHET_CHECKOUT=/opt/trebuchet

# allowed_signers file with the public SSH key(s) allowed to sign commits on main.
# Format: "<email> <ssh-ed25519 AAAA...>"
TREBUCHET_ALLOWED_SIGNERS=/etc/trebuchet/allowed_signers

# Services deployed from ghcr.io/<owner>/trebuchet-<service>
TREBUCHET_SERVICES="note vault caddy"

TREBUCHET_STATE_DIR=/var/lib/trebuchet-deploy
TREBUCHET_HEALTH_TIMEOUT=60
