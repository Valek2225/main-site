[Unit]
Description=Trebuchet encrypted off-site backup (age -> S3 with Object Lock)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/trebuchet-backup run
Environment=HOME=/var/lib/trebuchet-backup
StateDirectory=trebuchet-backup
ProtectSystem=strict
ReadOnlyPaths=/srv/trebuchet/data /etc/trebuchet
ReadWritePaths=/run
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
